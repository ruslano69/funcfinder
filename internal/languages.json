{
  "go": {
    "name": "Go",
    "extensions": [
      ".go"
    ],
    "func_pattern": "^\\s*func\\s+(\\([^)]*\\)\\s+)?({IDENT}+)(?:\\[[^\\]]*\\])?\\s*\\(",
    "class_pattern": "^\\s*type\\s+({IDENT}+)\\s+(struct|interface)\\s*\\{",
    "struct_type_patterns": {
      "struct": "^\\s*type\\s+({IDENT}+)\\s+struct\\s*\\{",
      "interface": "^\\s*type\\s+({IDENT}+)\\s+interface\\s*\\{",
      "type_alias": "^\\s*type\\s+({IDENT}+)\\s*=\\s*",
      "named": "^\\s*type\\s+({IDENT}+)\\s+[^={\\s](?:.*[^{])?\\s*$"
    },
    "field_pattern": "^\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s+([a-zA-Z_][\\w\\[\\]*\\s]*)\\s*$",
    "call_pattern": "({IDENT}+)\\s*\\(",
    "import_pattern": "^\\s*(?:import\\s+\"([^\"]+)\"|\"([^\"]+)\"$)",
    "multi_line_import": "import (",
    "line_comment": "//",
    "block_comment_start": "/*",
    "block_comment_end": "*/",
    "comment_patterns": [
      "//.*"
    ],
    "string_chars": [
      "\""
    ],
    "char_delimiters": [
      "'"
    ],
    "raw_string_chars": [
      "`"
    ],
    "escape_char": "\\",
    "exclude_words": [
      "func",
      "type",
      "import",
      "const",
      "var",
      "package"
    ],
    "supports_nested": true,
    "nesting_pattern": "^\\s*\\}?\\s*(if|for|switch)\\b",
    "flat_pattern": "^\\s*\\}?\\s*(else|case)\\b",
    "loop_pattern": "^\\s*(for)\\b"
  },
  "c": {
    "name": "C",
    "extensions": [
      ".c",
      ".h"
    ],
    "func_pattern": "^\\w[\\w\\s\\*]*[\\s\\*]+(?:\\(\\s*({IDENT}+)\\s*\\)|({IDENT}+))\\s*\\(\\s*(?:[^*\\s]|$)",
    "class_pattern": "^\\s*(?:typedef\\s+)?struct\\s+(?:\\w+\\s*)?\\{",
    "struct_type_patterns": {
      "struct": "^\\s*(?:typedef\\s+)?(?:struct|union)\\s+(?:({IDENT}+)\\s*)?\\{",
      "typedef_struct": "^\\s*typedef\\s+struct(?:\\s+\\w+)?\\s*\\{\\s*({IDENT}+)\\s*\\}"
    },
    "field_pattern": "^\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\s*([a-zA-Z_][\\w\\s\\*\\[\\]]*)\\s*;",
    "call_pattern": "({IDENT}+)\\s*\\(",
    "import_pattern": "^\\s*#\\s*include\\s*[<\"]([^>\"]+)[>\"]",
    "line_comment": "//",
    "block_comment_start": "/*",
    "block_comment_end": "*/",
    "comment_patterns": [
      "//.*"
    ],
    "string_chars": [
      "\"",
      "'"
    ],
    "raw_string_chars": [],
    "escape_char": "\\",
    "exclude_words": [
      "if",
      "else",
      "while",
      "for",
      "switch",
      "case",
      "return",
      "sizeof",
      "define",
      "include",
      "ifdef",
      "ifndef",
      "endif"
    ],
    "keywords_not_names": true,
    "supports_nested": false,
    "nesting_pattern": "^\\s*\\}?\\s*(if|else|for|while|do|switch|case|default)\\b",
    "flat_pattern": "^\\s*\\}?\\s*(else|case|default)\\b",
    "loop_pattern": "^\\s*(for|while|do)\\b"
  },
  "cpp": {
    "name": "C++",
    "extensions": [
      ".cpp",
      ".cc",
      ".cxx",
      ".hpp",
      ".h"
    ],
    "func_pattern": "^\\s*(?:template\\s*<.*?>\\s*)?(?:(?:[@\\w<\\[~*&][@\\w<>\\[\\],.?*&:~]*\\s+)+?(?:[\\w~]+::)*|(?:[\\w~]+(?:<[^()]*>)?::)+)(~?{IDENT}+|operator(?:\\s*(?:\\(\\)|\\[\\]|\"\"\\w+|[^\\w\\s(]+)|\\s+\\w+))(?:<[^()]*>)?\\s*\\((?:[^()]|\\([^()]*\\))*\\)\\s*(?:const\\s*)?(?:noexcept\\s*)?(?:(?:override|final)\\s*)*(?:->\\s*[^{;]*?)?(?:\\s*:[^{;]*)?\\s*(?:\\{.*)?$",
    "header_open_pattern": "^\\s*(?:[@\\w<\\[~*&][@\\w<>\\[\\],.?*&:~]*\\s+)+?(?:[\\w~]+::)*(~?{IDENT}+|operator(?:\\s*(?:\\(\\)|\\[\\]|\"\"\\w+|[^\\w\\s(]+)|\\s+\\w+))\\s*\\(",
    "constructor_pattern": "^\\s*(?:(?:explicit|inline|constexpr|virtual|FMT_[A-Z0-9_]+)\\s+)*(~?{IDENT}+)\\s*\\(",
    "declaration_pattern": "^\\s*(?:template\\s*<.*?>\\s*)?(?:(?:[@\\w<\\[~*&][@\\w<>\\[\\],.?*&:~]*\\s+)+?(?:[\\w~]+::)*)(~?{IDENT}+|operator(?:\\s*(?:\\(\\)|\\[\\]|\"\"\\w+|[^\\w\\s(]+)|\\s+\\w+))(?:<[^()]*>)?\\s*\\((?:\\s*\\)|(?:(?:\\s*(?:void|int|char|bool|float|double|long|short|unsigned|signed|size_t|auto)\\b|\\s*[A-Za-z_][\\w:]*(?:<[^()]*>)?(?:\\s+[*&]*|[*&]+)\\s*[A-Za-z_]|\\s*\\.\\.\\.))(?:[^()]|\\([^()]*\\))*\\)|\\s*[A-Za-z_][\\w:]*(?:<[^()]*>)?[*&]+\\s*(?:\\)|,(?:[^()]|\\([^()]*\\))*\\)))\\s*(?:const\\s*)?(?:noexcept\\s*)?(?:(?:override|final)\\s*)*(?:->\\s*[^{;]+?)?\\s*(?:=\\s*(?:0|default|delete)\\s*)?;\\s*$",
    "member_declaration_pattern": "^\\s*(?:template\\s*<.*?>\\s*)?(?:(?:[@\\w<\\[~*&][@\\w<>\\[\\],.?*&:~]*\\s+)+?(?:[\\w~]+::)*)(~?{IDENT}+|operator(?:\\s*(?:\\(\\)|\\[\\]|\"\"\\w+|[^\\w\\s(]+)|\\s+\\w+))(?:<[^()]*>)?\\s*\\((?:\\s*\\)|(?:(?:\\s*(?:void|int|char|bool|float|double|long|short|unsigned|signed|size_t|auto)\\b|\\s*[A-Za-z_][\\w:]*(?:<[^()]*>)?(?:\\s+[*&]*|[*&]+)\\s*[A-Za-z_]|\\s*\\.\\.\\.))(?:[^()]|\\([^()]*\\))*\\)|\\s*[A-Za-z_][\\w:]*(?:<[^()]*>)?[*&]+\\s*(?:\\)|,(?:[^()]|\\([^()]*\\))*\\))|\\s*[A-Za-z_][\\w:]*(?:<[^()]*>)?\\s*(?:\\)|,(?:[^()]|\\([^()]*\\))*\\)))\\s*(?:const\\s*)?(?:noexcept\\s*)?(?:(?:override|final)\\s*)*(?:->\\s*[^{;]+?)?\\s*(?:=\\s*(?:0|default|delete)\\s*)?;\\s*$",
    "initializer_lists": true,
    "statement_words": ["if", "else", "while", "for", "switch", "case", "do", "catch", "return", "throw", "new", "delete", "co_return", "co_await", "co_yield", "static_assert", "sizeof", "typeid", "template"],
    "conversion_operator_pattern": "\\boperator\\s+([\\w:<>*&\\s]+?)\\s*\\(",
    "class_pattern": "^\\s*(?:template\\s*<.*>\\s*)?(?:[\\w\\s]+\\s+)?(?:class|struct)\\s+(?:[A-Z][A-Z0-9_]*\\s+)?({IDENT}+)",
    "struct_type_patterns": {
      "class": "^\\s*(?:\\w+\\s+)?class\\s+({IDENT}+)",
      "struct": "^\\s*(?:\\w+\\s+)?struct\\s+({IDENT}+)",
      "interface": "^\\s*(?:\\w+\\s+)?class\\s+({IDENT}+)\\s*:",
      "enum": "^\\s*(?:\\w+\\s+)?enum\\s+(?:class\\s+)?({IDENT}+)",
      "union": "^\\s*(?:\\w+\\s+)?union\\s+({IDENT}+)"
    },
    "field_pattern": "^\\s*(?:const\\s+)?(?:\\w+(?:<[^>]*>)?\\s+)+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?:\\[\\s*\\]\\s*)?(?:=|;|,)",
    "call_pattern": "({IDENT}+)\\s*\\(",
    "import_pattern": "^\\s*#\\s*include\\s*[<\"]([^>\"]+)[>\"]",
    "line_comment": "//",
    "block_comment_start": "/*",
    "block_comment_end": "*/",
    "comment_patterns": [
      "//.*"
    ],
    "string_chars": [
      "\"",
      "'"
    ],
    "raw_string_chars": [],
    "escape_char": "\\",
    "exclude_words": [
      "if",
      "else",
      "while",
      "for",
      "switch",
      "case",
      "return",
      "sizeof",
      "define",
      "include",
      "typedef",
      "namespace",
      "using",
      "constexpr",
      "static_assert",
      "decltype",
      "noexcept",
      "alignas",
      "alignof",
      "requires",
      "throw",
      "new",
      "delete",
      "typeid",
      "static_cast",
      "dynamic_cast",
      "const_cast",
      "reinterpret_cast",
      "co_return",
      "co_await",
      "co_yield",
      "template",
      "unsigned",
      "signed",
      "int",
      "char",
      "bool",
      "void",
      "long",
      "short",
      "float",
      "double",
      "wchar_t"
    ],
    "keywords_not_names": true,
    "supports_nested": false,
    "nesting_pattern": "^\\s*\\}?\\s*(if|else|for|while|do|switch|case|default|catch)\\b",
    "flat_pattern": "^\\s*\\}?\\s*(else|case|default)\\b",
    "loop_pattern": "^\\s*(for|while|do)\\b"
  },
