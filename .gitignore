# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
# Anchored to the repo root on purpose: a bare "complexity" matches at every
# level, so it swallowed cmd/complexity/ whole and any new file inside it was
# invisible to git. Same for the five names beside it.
/funcfinder
/stat
/deps
/complexity
/callgraph
/docsearch
/docsearch-server
dist/

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.txt
coverage.html

# Dependency directories
vendor/

# Go workspace file
go.work

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Build artifacts
build/
bin/

# Temporary files
*.tmp
*.log
/benchmark
cmd/*/funcfinder
cmd/*/stat
cmd/*/deps
cmd/*/complexity
cmd/*/benchmark
codebase_map.json
.codemap/
